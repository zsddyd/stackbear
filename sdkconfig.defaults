# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# LVGL 内置 malloc 池大小(字节)。它是独立静态区、不与系统堆共享,配大了会白白占用 RAM。
#
# 用字节单位而非已弃用的 CONFIG_LV_MEM_SIZE_KILOBYTES:LVGL 9.6 起后者只是兼容项,
# 而 ESP-IDF 生成的 sdkconfig 会把所有 int 符号连同默认值写入,于是 KB 符号与
# LV_MEM_SIZE 的默认值 65536 同时存在,LVGL 优先取后者 —— 旧写法实际得到 64 KB,
# 既白白多占 40 KB 静态 RAM,又让本行配置形同无效。
#
# 本板无 PSRAM,池按实测峰值配置:在主机上以 32 位(wasm32/ILP32,与 ESP32-C3
# 同样 4 字节指针)编译真实 UI 并读取 lv_mem_monitor(),7 个页面全部建好后的峰值为
# 32.9 KB。48 KB 留约 16 KB 余量,给后续新增页面/字体;不要调到 32 KB 以下。
CONFIG_LV_MEM_SIZE=49152

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# --- OTA ---
# 双槽 OTA:新固件写进备用槽,校验通过后切过去启动。打开回滚后,新固件若在
# "确认健康"之前崩溃,或未调用 esp_ota_mark_app_valid_cancel_rollback,
# bootloader 会自动切回上一个可用槽,降低 OTA 变砖风险。
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="0.5.0"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_ERR_TO_NAME_LOOKUP=y

# --- 分区表已在 partitions.csv 中改为 ota_0/ota_1/fota/audioq ---

# --- Bluetooth LE / NimBLE ---
# ESP32-C3 仅支持 BLE；示例只启用单连接 peripheral 所需的最小 host 配置。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n
